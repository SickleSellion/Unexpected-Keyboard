<?xml version="1.0" encoding="utf-8"?>
<keyboard name="QWERTY (US) Fold" script="latin">

  <row>
    <key c="q" ne="1" se="loc esc"/>
    <key c="w" nw="~" ne="2" sw="."/>
    <key c="e" nw="\?" ne="3" sw="," se="loc €"/>
    <key c="r" ne="4" sw="$"/>
    <key c="t" ne="5" sw="%"/>
    <key c="y" ne="6" sw="^"/>
    <key c="u" ne="7" sw="&amp;"/>
    <key c="i" ne="\?" sw="*" se=","/>
    <key c="o" ne="9" sw="(" se="."/>
    <key c="p" ne="0" sw="1P:app:com.onepassword.android" se="autofill"/>
  </row>

  <row>
    <key shift="0.5" c="a" nw="loc tab" ne="`" se="selectAll"/>
    <key c="s" ne="loc §" sw="loc ß"/>
    <key c="d"/>
    <key c="f"/>
    <key c="g" ne="-" sw="_"/>
    <key c="h" ne="=" sw="+"/>
    <key c="j" se="}" sw="{"/>
    <key c="k" sw="[" se="]"/>
    <key c="l" ne="|" sw="\\"/>
  </row>

  <row>
    <key width="1.5" c="shift" ne="loc capslock"/>
    <key c="z" ne="undo" sw="redo"/>
    <key c="x" ne="cut"/>
    <key c="c" nw="copy"/>
    <key c="v" nw="paste"/>
    <key c="b" sw="/" se="\\"/>
    <key c="n" ne=":" sw=";"/>
    <key c="m" ne="&quot;" sw="'"/>
    <key width="1.5" c="backspace" ne="delete" sw="delete_word" se="forward_delete_word"/>
  </row>

</keyboard>
